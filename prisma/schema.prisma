generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model tenants {
  email           String?          @db.VarChar(255)
  address         String?
  business_name   String           @db.VarChar(255)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?        @db.Timestamptz(6)
  is_active       Boolean          @default(true)
  logo_url        String?          @db.VarChar(500)
  nit             String?          @db.VarChar(20)
  phone           String?          @db.VarChar(20)
  slug            String           @unique @db.VarChar(100)
  timezone        String           @default("America/Bogota") @db.VarChar(50)
  updated_at      DateTime         @updatedAt @db.Timestamptz(6)
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customers       customers[]
  fields          fields[]
  licenses        licenses[]
  loyalty_configs loyalty_configs?
  payments        payments[]
  reservations    reservations[]
  tenant_users    tenant_users[]
}

model licenses {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String        @db.Uuid
  plan_name         String        @db.VarChar(100)
  price             Decimal       @db.Decimal(10, 2)
  starts_at         DateTime      @db.Date
  expires_at        DateTime      @db.Date
  status            LicenseStatus @default(active)
  payment_reference String?       @db.VarChar(255)
  notes             String?
  created_at        DateTime      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime      @updatedAt @db.Timestamptz(6)
  tenant            tenants       @relation(fields: [tenant_id], references: [id])
}

model tenant_users {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String         @db.Uuid
  stack_auth_id String?        @unique @db.VarChar(255)
  email         String         @unique @db.VarChar(255)
  full_name     String         @db.VarChar(255)
  role          TenantUserRole @default(staff)
  is_active     Boolean        @default(true)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  updated_at    DateTime       @updatedAt @db.Timestamptz(6)
  deleted_at    DateTime?      @db.Timestamptz(6)
  password_hash String?        @db.VarChar(255)
  payments      payments[]
  reservations  reservations[]
  tenant        tenants        @relation(fields: [tenant_id], references: [id])
}

model fields {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String            @db.Uuid
  name            String            @db.VarChar(150)
  field_type      FieldType
  price_per_hour  Decimal           @db.Decimal(10, 2)
  surface         FieldSurface      @default(synthetic)
  is_active       Boolean           @default(true)
  created_at      DateTime          @default(now()) @db.Timestamptz(6)
  updated_at      DateTime          @updatedAt @db.Timestamptz(6)
  deleted_at      DateTime?         @db.Timestamptz(6)
  field_schedules field_schedules[]
  tenant          tenants           @relation(fields: [tenant_id], references: [id])
  reservations    reservations[]
}

model field_schedules {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  field_id              String   @db.Uuid
  tenant_id             String   @db.Uuid
  day_of_week           Int      @db.SmallInt
  open_time             String   @db.VarChar(5)
  close_time            String   @db.VarChar(5)
  slot_duration_minutes Int      @default(60) @db.SmallInt
  is_active             Boolean  @default(true)
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt @db.Timestamptz(6)
  field                 fields   @relation(fields: [field_id], references: [id])
}

model customers {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id          String         @db.Uuid
  phone              String         @db.VarChar(20)
  full_name          String         @db.VarChar(255)
  email              String?        @db.VarChar(255)
  notes              String?
  reservations_count Int            @default(0)
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  updated_at         DateTime       @updatedAt @db.Timestamptz(6)
  deleted_at         DateTime?      @db.Timestamptz(6)
  tenant             tenants        @relation(fields: [tenant_id], references: [id])
  reservations       reservations[]

  @@unique([tenant_id, phone])
}

model loyalty_configs {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id               String   @unique @db.Uuid
  reservations_for_reward Int      @default(10) @db.SmallInt
  reward_description      String
  is_active               Boolean  @default(true)
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @updatedAt @db.Timestamptz(6)
  tenant                  tenants  @relation(fields: [tenant_id], references: [id])
}

model reservations {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String            @db.Uuid
  field_id            String            @db.Uuid
  customer_id         String            @db.Uuid
  created_by          String            @db.Uuid
  reservation_date    DateTime          @db.Date
  start_time          String            @db.VarChar(5)
  end_time            String            @db.VarChar(5)
  duration_minutes    Int               @db.SmallInt
  total_amount        Decimal           @db.Decimal(10, 2)
  paid_amount         Decimal           @default(0) @db.Decimal(10, 2)
  payment_status      PaymentStatus     @default(unpaid)
  status              ReservationStatus @default(confirmed)
  notes               String?
  cancellation_reason String?
  created_at          DateTime          @default(now()) @db.Timestamptz(6)
  updated_at          DateTime          @updatedAt @db.Timestamptz(6)
  deleted_at          DateTime?         @db.Timestamptz(6)
  payments            payments[]
  created_by_user     tenant_users      @relation(fields: [created_by], references: [id])
  customer            customers         @relation(fields: [customer_id], references: [id])
  field               fields            @relation(fields: [field_id], references: [id])
  tenant              tenants           @relation(fields: [tenant_id], references: [id])
}

model payments {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String        @db.Uuid
  reservation_id   String        @db.Uuid
  received_by      String        @db.Uuid
  amount           Decimal       @db.Decimal(10, 2)
  payment_method   PaymentMethod @default(cash)
  reference        String?       @db.VarChar(255)
  notes            String?
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  received_by_user tenant_users  @relation(fields: [received_by], references: [id])
  reservation      reservations  @relation(fields: [reservation_id], references: [id])
  tenant           tenants       @relation(fields: [tenant_id], references: [id])
}

enum LicenseStatus {
  active
  expired
  suspended
}

enum TenantUserRole {
  owner
  admin
  staff
}

enum FieldType {
  futbol5
  futbol7
  futbol11
}

enum FieldSurface {
  synthetic
  natural
  hybrid
}

enum PaymentStatus {
  unpaid
  partial
  paid
}

enum ReservationStatus {
  confirmed
  completed
  cancelled
  no_show
}

enum PaymentMethod {
  cash
  nequi
  transfer
  other
}
